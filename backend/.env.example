NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/bosa_affa
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

ADMIN_DEFAULT_USERNAME=your_admin_username
ADMIN_DEFAULT_PASSWORD=your_admin_password

FORCE_ADMIN_DEFAULT_USERNAME=your_force_admin_username
FORCE_ADMIN_DEFAULT_PASSWORD=your_force_admin_password

# Multer upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Cloudflare R2 (S3-compatible)
# Example endpoint format:
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
# Optional: if your bucket is publicly readable (or you use a public domain)
R2_PUBLIC_BASE_URL=
